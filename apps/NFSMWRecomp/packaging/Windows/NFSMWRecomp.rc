#include <windows.h>

#define IDI_ICON1 101

IDI_ICON1 ICON "NFSMWRecomp.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @NFSMW_RECOMP_VERSION_RC@
 PRODUCTVERSION @NFSMW_RECOMP_VERSION_RC@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "000904b0"
    BEGIN
      VALUE "Comments", "Not affiliated with or endorsed by EA games."
      VALUE "CompanyName", "NFSMWRecomp Project"
      VALUE "FileDescription", "NFSMWRecomp"
      VALUE "FileVersion", "@NFSMW_RECOMP_VERSION_MANIFEST@"
      VALUE "InternalName", "NFSMWRecomp"
      VALUE "LegalCopyright", "Copyright (c) NFSMWRecomp Contributors"
      VALUE "OriginalFilename", "NFSMWRecomp.exe"
      VALUE "ProductName", "NFSMWRecomp"
      VALUE "ProductVersion", "@NFSMW_RECOMP_VERSION_MANIFEST@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0009, 1200
  END
END
