{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "hidden": true,
      "name": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",

        "REXSDK_DIR": "${sourceDir}/vendor/rexglue-sdk"
      }
    },

    {
      "hidden": true,
      "name": "windows-base",
      "inherits": "base",
      "cacheVariables": {
        "REXGLUE_USE_D3D12": false,
        "REXGLUE_USE_VULKAN": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },

    {
      "hidden": true,
      "name": "linux-base",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },

    {
      "hidden": true,
      "name": "macos-base",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },

    {
      "hidden": true,
      "name": "amd64-base",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-march=x86-64-v2",
        "CMAKE_CXX_FLAGS": "-march=x86-64-v2"
      }
    },

    {
      "hidden": true,
      "name": "arm64-base",
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-march=armv8-a",
        "CMAKE_CXX_FLAGS": "-march=armv8-a"
      }
    },

    {
      "hidden": true,
      "name": "debug-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "hidden": true,
      "name": "release-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",

        "REXGLUE_ENABLE_TRACY": false,
        "REXGLUE_ENABLE_PERF_COUNTERS": false
      }
    },
    {
      "hidden": true,
      "name": "relwithdebinfo-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },

    {
      "name": "win-amd64-debug",
      "displayName": "Windows AMD64 Debug",
      "inherits": ["windows-base", "amd64-base", "debug-base"]
    },
    {
      "name": "win-amd64-release",
      "displayName": "Windows AMD64 Release",
      "inherits": ["windows-base", "amd64-base", "release-base"]
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "displayName": "Windows AMD64 RelWithDebInfo",
      "inherits": ["windows-base", "amd64-base", "relwithdebinfo-base"]
    },

    {
      "name": "win-arm64-debug",
      "displayName": "Windows ARM64 Debug",
      "inherits": ["windows-base", "arm64-base", "debug-base"]
    },
    {
      "name": "win-arm64-release",
      "displayName": "Windows ARM64 Release",
      "inherits": ["windows-base", "arm64-base", "release-base"]
    },
    {
      "name": "win-arm64-relwithdebinfo",
      "displayName": "Windows ARM64 RelWithDebInfo",
      "inherits": ["windows-base", "arm64-base", "relwithdebinfo-base"]
    },

    {
      "name": "linux-amd64-debug",
      "displayName": "Linux AMD64 Debug",
      "inherits": ["linux-base", "amd64-base", "debug-base"]
    },
    {
      "name": "linux-amd64-release",
      "displayName": "Linux AMD64 Release",
      "inherits": ["linux-base", "amd64-base", "release-base"]
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "displayName": "Linux AMD64 RelWithDebInfo",
      "inherits": ["linux-base", "amd64-base", "relwithdebinfo-base"]
    },

    {
      "name": "linux-arm64-debug",
      "displayName": "Linux ARM64 Debug",
      "inherits": ["linux-base", "arm64-base", "debug-base"]
    },
    {
      "name": "linux-arm64-release",
      "displayName": "Linux ARM64 Release",
      "inherits": ["linux-base", "arm64-base", "release-base"]
    },
    {
      "name": "linux-arm64-relwithdebinfo",
      "displayName": "Linux ARM64 RelWithDebInfo",
      "inherits": ["linux-base", "arm64-base", "relwithdebinfo-base"]
    },

    {
      "name": "macos-amd64-debug",
      "displayName": "macOS AMD64 Debug",
      "inherits": ["macos-base", "amd64-base", "debug-base"]
    },
    {
      "name": "macos-amd64-release",
      "displayName": "macOS AMD64 Release",
      "inherits": ["macos-base", "amd64-base", "release-base"]
    },
    {
      "name": "macos-amd64-relwithdebinfo",
      "displayName": "macOS AMD64 RelWithDebInfo",
      "inherits": ["macos-base", "amd64-base", "relwithdebinfo-base"]
    },

    {
      "name": "macos-arm64-debug",
      "displayName": "macOS ARM64 Debug",
      "inherits": ["macos-base", "arm64-base", "debug-base"]
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS ARM64 Release",
      "inherits": ["macos-base", "arm64-base", "release-base"]
    },
    {
      "name": "macos-arm64-relwithdebinfo",
      "displayName": "macOS ARM64 RelWithDebInfo",
      "inherits": ["macos-base", "arm64-base", "relwithdebinfo-base"]
    }
  ],
  "buildPresets": [
    {
      "name": "win-amd64-debug",
      "configurePreset": "win-amd64-debug"
    },
    {
      "name": "win-amd64-release",
      "configurePreset": "win-amd64-release"
    },
    {
      "name": "win-amd64-relwithdebinfo",
      "configurePreset": "win-amd64-relwithdebinfo"
    },

    {
      "name": "win-arm64-debug",
      "configurePreset": "win-arm64-debug"
    },
    {
      "name": "win-arm64-release",
      "configurePreset": "win-arm64-release"
    },
    {
      "name": "win-arm64-relwithdebinfo",
      "configurePreset": "win-arm64-relwithdebinfo"
    },

    {
      "name": "linux-amd64-debug",
      "configurePreset": "linux-amd64-debug"
    },
    {
      "name": "linux-amd64-release",
      "configurePreset": "linux-amd64-release"
    },
    {
      "name": "linux-amd64-relwithdebinfo",
      "configurePreset": "linux-amd64-relwithdebinfo"
    },

    {
      "name": "linux-arm64-debug",
      "configurePreset": "linux-arm64-debug"
    },
    {
      "name": "linux-arm64-release",
      "configurePreset": "linux-arm64-release"
    },
    {
      "name": "linux-arm64-relwithdebinfo",
      "configurePreset": "linux-arm64-relwithdebinfo"
    },

    {
      "name": "macos-amd64-debug",
      "configurePreset": "macos-amd64-debug"
    },
    {
      "name": "macos-amd64-release",
      "configurePreset": "macos-amd64-release"
    },
    {
      "name": "macos-amd64-relwithdebinfo",
      "configurePreset": "macos-amd64-relwithdebinfo"
    },

    {
      "name": "macos-arm64-debug",
      "configurePreset": "macos-arm64-debug"
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release"
    },
    {
      "name": "macos-arm64-relwithdebinfo",
      "configurePreset": "macos-arm64-relwithdebinfo"
    }
  ]
}
